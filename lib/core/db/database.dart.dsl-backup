import 'dart:async';

import 'package:drift/drift.dart';
import 'package:drift/native.dart' as drift_native;
import 'package:drift_flutter/drift_flutter.dart' show driftDatabase;
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'package:openaccounting/core/db/gobd_triggers.dart';
import 'package:openaccounting/core/db/migrations.dart';
import 'package:openaccounting/core/db/profile_manager.dart';
import 'package:openaccounting/core/db/seed.dart';

part 'database.g.dart'; // This will be generated by drift

// TABLE DEFINITIONS

class Unternehmen extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255)();
  TextColumn get strasse => text().withLength(max: 255)();
  TextColumn get plz => text().withLength(max: 20)();
  TextColumn get ort => text().withLength(max: 255)();
  TextColumn get land => text().withLength(max: 3).withDefault(const Constant('DE'))();
  TextColumn get steuernummer => text().withLength(max: 20)();
  TextColumn get ustIdnr => text().withLength(max: 20)();
  TextColumn get iban => text().withLength(max: 34)();
  TextColumn get bic => text().withLength(max: 11)();
  TextColumn get finanzamt => text().withLength(max: 255)();
  IntegerColumn get kleinunternehmer => integer().withDefault(const Constant(0))();
  IntegerColumn get profilmanagerAktiv => integer().withDefault(const Constant(0))();
  TextColumn backupExternPfad => text().withLength(max: 255)();
  IntegerColumn backupExternPfadLokalOk => integer().withDefault(const Constant(0))();
  TextColumn logoPfad => text().withLength(max: 255)();
  DateTimeColumn get erstellungsdatum => dateTime().withDefault(currentDateAndTime)();
}

class Kunden extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get kundennummer => text().withLength(max: 20)();
  TextColumn get name => text().withLength(min: 1, max: 255)();
  TextColumn get firma => text().withLength(max: 255)();
  TextColumn get strasse => text().withLength(max: 255)();
  TextColumn get plz => text().withLength(max: 20)();
  TextColumn get ort => text().withLength(max: 255)();
  TextColumn get land => text().withLength(max: 3).withDefault(const Constant('DE'))();
  TextColumn get email => text().withLength(max: 255)();
  TextColumn get telefon => text().withLength(max: 50)();
  TextColumn get ustIdnr => text().withLength(max: 20)();
  IntegerColumn get zahlungsziel => integer().withDefault(const Constant(14))();
  IntColumn get skontoProzent => integer().withDefault(const Constant(0))();
  TextColumn get notiz => text().withLength(max: 1000)();
  DateTimeColumn get erstellungsdatum => dateTime().withDefault(currentDateAndTime)();

  @override
  Set<Index> get indices => {
        Index(
          expression: [kundennummer],
          where: (kundennummer.isNotNull()),
        ),
      };
}

class Lieferanten extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get lieferantennummer => text().withLength(max: 20)();
  TextColumn get name => text().withLength(min: 1, max: 255)();
  TextColumn get strasse => text().withLength(max: 255)();
  TextColumn get plz => text().withLength(max: 20)();
  TextColumn get ort => text().withLength(max: 255)();
  TextColumn get land => text().withLength(max: 3).withDefault(const Constant('DE'))();
  TextColumn get email => text().withLength(max: 255)();
  TextColumn get telefon => text().withLength(max: 50)();
  TextColumn get ustIdnr => text().withLength(max: 20)();
  TextColumn get iban => text().withLength(max: 34)();

  @override
  Set<Index> get indices => {
        Index(
          expression: [lieferantennummer],
          where: (lieferantennummer.isNotNull()),
        ),
      };
}

class Artikel extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get artikelnummer => text().withLength(max: 50)();
  TextColumn get bezeichnung => text().withLength(min: 1, max: 255)();
  TextColumn get beschreibung => text().withLength(max: 1000)();
  TextColumn get einheit => text().withLength(max: 50).withDefault(const Constant('Stk'))();
  RealColumn get vkNetto => real().withDefault(const Constant(0.0)); // NUMERIC(12,4)
  RealColumn get ekPreis => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  IntColumn get ustSatzId => integer().references(UstSaetze, #id)();
  IntColumn get gruppeId => integer().references(ArtikelGruppen, #id)();
  TextColumn get typ => text().withLength(max: 50).withDefault(const Constant('ware'))();
  IntegerColumn get bestand => integer().withDefault(const Constant(0))();
  IntegerColumn get mindestbestand => integer().withDefault(const Constant(0))();
  IntegerColumn get aktiv => integer().withDefault(const Constant(1))();
}

class UstSaetze extends Table {
  IntColumn get id => integer().autoIncrement()();
  RealColumn get satz => real().notNull(); // NUMERIC(12,2)
  TextColumn get bezeichnung => text().withLength(min: 1, max: 255).notNull();
  DateTimeColumn get gueltigAb => dateTime();
}

class Nummernkreise extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get typ => text().withLength(max: 50).notNull().unique();
  TextColumn get prefix => text().withLength(max: 50)();
  TextColumn get format => text().withLength(max: 50).notNull();
  IntegerColumn get naechsteNummer => integer().withDefault(const Constant(1))();
  IntegerColumn get aktiv => integer().withDefault(const Constant(1))();
}

class EuLaender extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get laendercode => text().withLength(max: 3).notNull().unique();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  TextColumn get ustIdnrFormat => text().withLength(max: 50)();
}

class ArtikelGruppen extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  TextColumn get beschreibung => text().withLength(max: 1000)();
}

class Konten extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  TextColumn get iban => text().withLength(max: 34)();
  TextColumn get bic => text().withLength(max: 11)();
  TextColumn get waehrung => text().withLength(max: 10).withDefault(const Constant('EUR'))();
  TextColumn get kontoart => text().withLength(max: 50)();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  RealColumn get saldo => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
}

class BankTransaktionen extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get kontoId => integer().notNull().references(Konten, #id)();
  IntColumn get importId => integer().references(BankImports, #id)();
  DateTimeColumn get datum => dateTime().notNull();
  RealColumn get betrag => real().notNull(); // NUMERIC(12,2)
  TextColumn get verwendungszweck => text().withLength(max: 255)();
  TextColumn get gegenkonto => text().withLength(max: 50)();
  TextColumn get gegenkontoName => text().withLength(max: 255)();
  IntColumn get kategorieId => integer().references(Kategorien, #id)();
  IntColumn get journalId => integer().references(Journal, #id)();
  TextColumn get dedupeHash => text().withLength(max: 255)();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('neu'))();

  @override
  Set<Index> get indices => {
        Index(
          expression: [kontoId, dedupeHash],
          where: (dedupeHash.isNotNull()),
        ),
      };
}

class BankTemplates extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  TextColumn get typ => text().withLength(max: 50).notNull();
  TextColumn get konfiguration => text().withLength(max: 1000)();
}

class BankImports extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get kontoId => integer().references(Konten, #id)();
  TextColumn get dateiname => text().withLength(max: 255)();
  DateTimeColumn get datum => dateTime().withDefault(currentDateAndTime)();
  IntegerColumn get anzahlTransaktionen => integer().withDefault(const Constant(0))();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('importiert'))();
}

class KundenBelege extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get kundeId => integer().notNull().references(Kunden, #id)();
  IntColumn get belegId => integer().notNull().references(Belege, #id)();
  TextColumn get rolle => text().withLength(max: 50)();
}

class KundenLieferadressen extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get kundeId => integer().notNull().references(Kunden, #id)();
  TextColumn get bezeichnung => text().withLength(max: 255)();
  TextColumn get strasse => text().withLength(max: 255)();
  TextColumn get plz => text().withLength(max: 20)();
  TextColumn get ort => text().withLength(max: 255)();
  TextColumn get land => text().withLength(max: 255)();
}

class Kategorien extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get bezeichnung => text().withLength(min: 1, max: 255).notNull();
  TextColumn get beschreibung => text().withLength(max: 1000)();
  TextColumn get kontoSkr03 => text().withLength(max: 50)();
  TextColumn get kontoSkr04 => text().withLength(max: 50)();
  IntegerColumn get euerZeile => integer();
  IntegerColumn get aktiv => integer().withDefault(const Constant(1))();
  TextColumn get typ => text().withLength(max: 50)();
}

class Rechnungen extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get rechnungsnummer => text().withLength(max: 50).notNull();
  TextColumn get typ => text().withLength(max: 50).notNull();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('entwurf'))();
  IntColumn get kundeId => integer().references(Kunden, #id)();
  IntColumn get lieferantId => integer().references(Lieferanten, #id)();
  DateTimeColumn get datum => dateTime().notNull();
  DateTimeColumn get faelligkeit => dateTime();
  RealColumn get nettoBetrag => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  RealColumn get bruttoBetrag => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  RealColumn get ustBetrag => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  IntColumn get skontoProzent => integer().withDefault(const Constant(0))();
  DateTimeColumn get skontoFaelligkeit => dateTime();
  TextColumn get notiz => text().withLength(max: 1000)();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  IntColumn get nummernkreisId => integer().references(Nummernkreise, #id)();
  IntColumn get stornoVon => integer().references(Rechnungen, #id, nullable: true)();
}

class Rechnungspositionen extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get rechnungId => integer().notNull().references(Rechnungen, #id)();
  IntColumn get artikelId => integer().references(Artikel, #id, nullable: true)();
  TextColumn get bezeichnung => text().withLength(min: 1, max: 255).notNull();
  RealColumn get menge => real().withDefault(const Constant(1.0)); // NUMERIC(12,2)
  RealColumn get einzelpreis => real().notNull(); // NUMERIC(12,2)
  RealColumn get gesamt => real().notNull(); // NUMERIC(12,2)
  RealColumn get ustSatz => real().withDefault(const Constant(19.0)); // NUMERIC(12,2)
  IntegerColumn get position => integer().withDefault(const Constant(0))();
}

class Belege extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get belegnummer => text().withLength(max: 50)();
  TextColumn get typ => text().withLength(max: 50)();
  DateTimeColumn get datum => dateTime().notNull();
  RealColumn get betrag => real().notNull(); // NUMERIC(12,2)
  IntColumn get kontoId => integer().references(Konten, #id)();
  IntColumn get kategorieId => integer().references(Kategorien, #id)();
  IntColumn get lieferantId => integer().references(Lieferanten, #id)();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('neu'))();
  TextColumn get beschreibung => text().withLength(max: 1000)();
  TextColumn get dateipfad => text().withLength(max: 255)();
}

class Journal extends Table {
  IntColumn get id => integer().autoIncrement()();
  DateTimeColumn get datum => dateTime().notNull();
  TextColumn get belegNr => text().withLength(max: 50)();
  IntColumn get kategorieId => integer().references(Kategorien, #id)();
  IntColumn get kontoId => integer().references(Konten, #id)();
  RealColumn get betrag => real().notNull(); // NUMERIC(12,2)
  RealColumn get soll => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  RealColumn get haben => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  TextColumn get beschreibung => text().withLength(max: 1000)();
  IntegerColumn get immutable => integer().withDefault(const Constant(0))();
  TextColumn get belegTyp => text().withLength(max: 50)();
  IntColumn get sollKontoId => integer().references(Konten, #id, nullable: true)();
  IntColumn get habenKontoId => integer().references(Konten, #id, nullable: true)();
  IntColumn get rechnungId => integer().references(Rechnungen, #id, nullable: true)();
  IntColumn get belegId => integer().references(Belege, #id, nullable: true)();
  DateTimeColumn get erstellungsdatum => dateTime().withDefault(currentDateAndTime)();
  IntColumn get stornoVon => integer().references(Journal, #id, nullable: true)();
  IntColumn get ustSatzId => integer().references(UstSaetze, #id, nullable: true)();
  TextColumn get kontoSkr03Snapshot => text().withLength(max: 50)();
  TextColumn get kontoSkr04Snapshot => text().withLength(max: 50)();
}

class TageAbschluesse extends Table {
  IntColumn get id => integer().autoIncrement()();
  DateTimeColumn get datum => dateTime().notNull();
  RealColumn get betrag => real().notNull(); // NUMERIC(12,2)
  RealColumn get kassenbestand => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  RealColumn get differenz => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  IntColumn get kontoId => integer().references(Konten, #id)();
  TextColumn get signatur => text().withLength(max: 255)();
  DateTimeColumn get erstellungsdatum => dateTime().withDefault(currentDateAndTime)();
}

class UstvaExporte extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get zeitraum => text().withLength(max: 50).notNull();
  IntegerColumn get jahr => integer().notNull();
  IntegerColumn get monat => integer();
  IntegerColumn get quartal => integer();
  TextColumn get kzSummen => text().withLength(max: 255)();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('entwurf'))();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  DateTimeColumn get erstellungsdatum => dateTime().withDefault(currentDateAndTime)();
}

class EuerExporte extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntegerColumn get jahr => integer().notNull();
  TextColumn get summen => text().withLength(max: 1000)();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('entwurf'))();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
}

class EksExporte extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntegerColumn get jahr => integer().notNull();
  TextColumn get daten => text().withLength(max: 1000)();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('entwurf'))();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  IntegerColumn get seite => integer().withDefault(const Constant(1))();
}

class DatevExportLog extends Table {
  IntColumn get id => integer().autoIncrement()();
  DateTimeColumn get datum => dateTime().withDefault(currentDateAndTime)();
  TextColumn get zeitraumVon => text().withLength(max: 50)();
  TextColumn get zeitraumBis => text().withLength(max: 50)();
  IntegerColumn get anzahlBuchungen => integer().withDefault(const Constant(0))();
  TextColumn get dateiPfad => text().withLength(max: 255)();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  TextColumn get status => text().withLength(max: 50)();
}

class EksEinstellungen extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  IntegerColumn get bedarfsgemeinschaft => integer().withDefault(const Constant(0))();
  RealColumn get kostenUnterkunft => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
}

class VorsteuerAnsprueche extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get belegId => integer().references(Belege, #id)();
  IntColumn get rechnungId => integer().references(Rechnungen, #id)();
  RealColumn get betrag => real().notNull(); // NUMERIC(12,2)
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('offen'))();
  TextColumn get faelligkeit => text().withLength(max: 50)();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
}

class Schnellbuchungen extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  IntColumn get kategorieId => integer().references(Kategorien, #id)();
  IntColumn get kontoId => integer().references(Konten, #id)();
  RealColumn get betrag => real().notNull(); // NUMERIC(12,2)
  TextColumn get beschreibung => text().withLength(max: 1000)();
}

class AutoFilterRegeln extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get muster => text().withLength(min: 1, max: 255).notNull();
  IntColumn get kategorieId => integer().references(Kategorien, #id)();
  IntColumn get kontoId => integer().references(Konten, #id)();
  IntegerColumn get prioritaet => integer().withDefault(const Constant(0))();
  IntegerColumn get aktiv => integer().withDefault(const Constant(1))();
}

class Forderungen extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get kundeId => integer().references(Kunden, #id)();
  IntColumn get rechnungId => integer().references(Rechnungen, #id)();
  RealColumn get betrag => real().notNull(); // NUMERIC(12,2)
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('offen'))();
  TextColumn get faelligkeit => text().withLength(max: 50)();
  TextColumn get beschreibung => text().withLength(max: 1000)();
}

class Mahnstufen extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntegerColumn get stufe => integer().notNull();
  TextColumn get bezeichnung => text().withLength(min: 1, max: 255).notNull();
  IntegerColumn get tageNachFaelligkeit => integer().withDefault(const Constant(0))();
  RealColumn get gebuehr => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  RealColumn get zinssatz => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  IntegerColumn get systemStufe => integer().withDefault(const Constant(0))();
}

class MahnwesenEinstellungen extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntegerColumn get aktiv => integer().withDefault(const Constant(0))();
  IntegerColumn get schwelleWarnung => integer().withDefault(const Constant(2))();
  IntegerColumn get schwelleSperrung => integer().withDefault(const Constant(3))();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
}

class Mahnungen extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get rechnungId => integer().notNull().references(Rechnungen, #id)();
  IntColumn get kundeId => integer().references(Kunden, #id)();
  IntColumn get stufeId => integer().references(Mahnstufen, #id)();
  DateTimeColumn get datum => dateTime().notNull();
  RealColumn get betrag => real().notNull(); // NUMERIC(12,2)
  RealColumn get gebuehr => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  RealColumn get zinsen => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('offen'))();
  TextColumn get snapshot => text().withLength(max: 1000)();
}

class AnlageVerzeichnis extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get bezeichnung => text().withLength(min: 1, max: 255).notNull();
  DateTimeColumn get anschaffungsdatum => dateTime();
  RealColumn get anschaffungskosten => real().notNull(); // NUMERIC(12,2)
  IntegerColumn get nutzungsdauer => integer();
  IntColumn get kategorieId => integer().references(Kategorien, #id)();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('aktiv'))();
  RealColumn get privatanteil => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
}

class DokumentenPakete extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  IntColumn get unternehmenId => integer().references(Unternehmen, #id)();
  DateTimeColumn get erstellungsdatum => dateTime().withDefault(currentDateAndTime)();
  TextColumn get status => text().withLength(max: 50).withDefault(const Constant('offen'))();
}

class DokumentenPaketBelege extends Table {
  IntColumn get id => integer().autoIncrement()();
  IntColumn get paketId => integer().notNull().references(DokumentenPakete, #id)();
  IntColumn get belegId => integer().notNull().references(Belege, #id)();
}

class RechnungsVorlagen extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  IntColumn get kundeId => integer().references(Kunden, #id)();
  TextColumn get intervall => text().withLength(max: 50)();
  TextColumn get naechsteFaelligkeit => text().withLength(max: 50)();
  IntegerColumn get aktiv => integer().withDefault(const Constant(1))();
  TextColumn get vorlageDaten => text().withLength(max: 1000)();
}

class BuchungsVorlagen extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  IntColumn get kategorieId => integer().references(Kategorien, #id)();
  IntColumn get kontoId => integer().references(Konten, #id)();
  RealColumn get betrag => real().withDefault(const Constant(0.0)); // NUMERIC(12,2)
  TextColumn get beschreibung => text().withLength(max: 1000)();
  TextColumn get modus => text().withLength(max: 50).withDefault(const Constant('direkt'))();
  IntegerColumn get aktiv => integer().withDefault(const Constant(1))();
}

class ImportMappingVorlagen extends Table {
  IntColumn get id => integer().autoIncrement()();
  TextColumn get name => text().withLength(min: 1, max: 255).notNull();
  IntColumn get templateId => integer().references(BankTemplates, #id)();
  TextColumn get mapping => text().withLength(max: 1000)();
  IntegerColumn get aktiv => integer().withDefault(const Constant(1))();
}

// END TABLE DEFINITIONS

/// Drift-backed app database with 38 tables per spec §Table Definitions.
/// Ponytail ultra: raw SQL via drift executor — no codegen, minimal boilerplate.
/// Handles WAL, FK, schema versioning, GoBD triggers, seed, profiles.
@DriftDatabase(tables: [
  Unternehmen,
  Kunden,
  Lieferanten,
  Artikel,
  Journal,
  Rechnungen,
  Rechnungspositionen,
  Kategorien,
  Konten,
  Nummernkreise,
  UstSaetze,
  TageAbschluesse,
  Belege,
  Mahnungen,
  Mahnstufen,
  MahnwesenEinstellungen,
  Forderungen,
  BankTransaktionen,
  BankTemplates,
  BankImports,
  KundenBelege,
  KundenLieferadressen,
  ArtikelGruppen,
  RechnungsVorlagen,
  BuchungsVorlagen,
  AnlageVerzeichnis,
  DokumentenPakete,
  DokumentenPaketBelege,
  UstvaExporte,
  EuerExporte,
  EksExporte,
  DatevExportLog,
  EuLaender,
  EksEinstellungen,
  VorsteuerAnsprueche,
  Schnellbuchungen,
  AutoFilterRegeln,
  ImportMappingVorlagen,
])
class AppDatabase extends _$AppDatabase {
  // We keep the extra fields for profile management and state tracking.
  AppDatabase([QueryExecutor? executor, this.profileDir])
      : super(executor ?? driftDatabase(name: 'openaccounting')),
        _ownsExecutor = executor == null,
        _opened = false;

  AppDatabase.forTesting(QueryExecutor executor, {this.profileDir}) : super(executor), _ownsExecutor = true, _opened = false;

  final String? profileDir;
  final bool _ownsExecutor;
  bool _opened = false;

  @override
  int get schemaVersion => MigrationRunner.currentVersion;

  @override
  Future<void> ensureOpen() async {
    if (_opened) return;
    await super.ensureOpen(_NoopUser());
    await executor.runCustom('PRAGMA journal_mode = WAL');
    await executor.runCustom('PRAGMA foreign_keys = ON');
    // Verify WAL
    try {
      await executor.runCustom('PRAGMA wal_checkpoint(TRUNCATE)');
    } catch (_) {}
    final runner = MigrationRunner(executor: executor, profileDir: profileDir ?? ProfileManager.getDefaultBaseDir());
    final versionBefore = await runner.getUserVersion();
    final hasTablesBefore = await runner.hasAnyTables();
    print('Database version before migration: $versionBefore, hasTables: $hasTablesBefore');
    // We use a callback to create the schema via drift.
    final migrated = await runner.run(createSchema: () async {
      // Create a temporary database instance to create the schema.
      // We don't need to keep this instance around; we just want to create the tables.
      final tempDb = AppDatabase(executor);
      await tempDb.create();
    });
    final versionAfter = await runner.getUserVersion();
    final hasTablesAfter = await runner.hasAnyTables();
    print('Database version after migration: $versionAfter, hasTables: $hasTablesAfter, migrated: $migrated');
    // Ensure triggers and seed idempotent even when no migration
    try {
      await GobdTriggers.install(executor);
    } catch (e) {
      print('Error installing GobdTriggers: $e');
      rethrow;
    }
    try {
      await SeedData.run(executor);
    } catch (e) {
      print('Error running SeedData: $e');
      rethrow;
    }
    // Ensure user_version set for fresh memory DB where runner may have skipped (hasTables false path sets version)
    final v = await runner.getUserVersion();
    if (v == 0) {
      await runner.setUserVersion(currentVersion);
    }
    _opened = true;
  }

  @override
  Future<void> close() async {
    if (_ownsExecutor) {
      await executor.close();
    }
    _opened = false;
  }

  /// Helper for VM tests creating in-memory instance with full schema.
  static AppDatabase createTestDatabase({String? profileDir}) {
    return AppDatabase.forTesting(drift_native.NativeDatabase.memory(), profileDir: profileDir);
  }

  /// Top-level helper for VM tests — matches legacy import path.
  AppDatabase createTestDatabase({String? profileDir}) => AppDatabase.createTestDatabase(profileDir: profileDir);

  class _NoopUser extends QueryExecutorUser {
    @override
    int get schemaVersion => 0;

    @override
    Future<void> beforeOpen(QueryExecutor executor, OpeningDetails details) async {}
  }

  final appDatabaseProvider = Provider<AppDatabase>((ref) {
    final db = AppDatabase();
    ref.onDispose(() {
      unawaited(db.close());
    });
    return db;
  });
}